# Local-first defaults
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional BYO-key providers. Keys stay on your machine; you can also paste them in Settings (memory only).
# Pick the model in Settings (the list comes from the provider), or set it here.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

MAX_AGENT_STEPS=8
DATABASE_URL=sqlite:///./taskwrite.db

# Folder where generated code/documents are saved for VS Code and Word
WORKSPACE_DIR=./workspaces

# MCP servers you want TaskWrite to be able to use (see mcp_servers.example.json)
MCP_CONFIG=./mcp_servers.json

# Where generated Python runs: Docker if available (SANDBOX_DOCKER=off to disable), else a locked-down process
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_S=10
SANDBOX_DOCKER=auto

# The server answers only to 127.0.0.1, localhost and [::1]. Add other host names (comma-separated) only if you
# open TaskWrite under another name, e.g. ALLOWED_HOSTS=my-pc
# ALLOWED_HOSTS=
